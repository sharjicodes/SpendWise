# Local Docker Compose PostgreSQL defaults are for development only.
DATABASE_URL=postgres://spendwise:spendwise-local@localhost:5434/spendwise
DATABASE_POOL_SIZE=5
BETTER_AUTH_URL=http://localhost:3000
# Generate your own secret before deployment: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters
